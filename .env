# CNPJ Data Pipeline + API
#
# Valores padrão de desenvolvimento (projeto público).
# Ajuste conforme o ambiente.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
RATE_LIMIT=100/minute
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Database — host local (porta publicada do Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/cnpj

# Redis — host local (porta publicada do Docker)
REDIS_URL=redis://localhost:6380/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=3600

# Pool SQLAlchemy
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Pipeline ETL
# ---------------------------------------------------------------------------
BATCH_SIZE=500000
TEMP_DIR=./temp
DOWNLOAD_WORKERS=4
PROCESS_WORKERS=1
RETRY_ATTEMPTS=3
RETRY_DELAY=5
CONNECT_TIMEOUT=30
READ_TIMEOUT=300
STALL_TIMEOUT=30
PROGRESS_LOG_INTERVAL=30
STALL_DEGRADE_THRESHOLD=3
LOADING_STRATEGY=upsert
KEEP_DOWNLOADED_FILES=false
